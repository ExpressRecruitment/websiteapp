# Copy this file to .env and fill in real values for local development.
# Expo inlines any EXPO_PUBLIC_* variable into the client bundle at build
# time - see https://docs.expo.dev/guides/environment-variables/
# Do not put secrets here that the app itself shouldn't be able to read.

# Jobs data source: "local" (bundled data/jobs.json snapshot, default) or
# "wordpress" (live REST API - use once this can reach the real site).
EXPO_PUBLIC_JOBS_SOURCE=local

# WordPress site base URL (no trailing slash).
EXPO_PUBLIC_WP_BASE_URL=https://www.express-recruitment.co.uk

# REST path (relative to /wp-json) that returns vacancy posts.
# Default assumes a custom "vacancy" CPT. Use /wp/v2/job_listing for WP Job Manager.
EXPO_PUBLIC_WP_JOBS_ENDPOINT_PATH=/wp/v2/vacancy

# REST path (relative to /wp-json) for the "division" taxonomy used to filter jobs.
EXPO_PUBLIC_WP_DIVISION_TAXONOMY_PATH=/wp/v2/division

# Formidable Forms submission endpoint (relative to /wp-json).
EXPO_PUBLIC_FORMIDABLE_SUBMIT_PATH=/frm/v2/entries

# Optional API key for the Formidable REST API add-on.
EXPO_PUBLIC_FORMIDABLE_API_KEY=

# Formidable form IDs - from WP Admin > Formidable > Forms > (form) > Settings.
EXPO_PUBLIC_FORMIDABLE_APPLICATION_FORM_ID=
EXPO_PUBLIC_FORMIDABLE_HIRE_FORM_ID=

# External timesheet portal.
EXPO_PUBLIC_TIMESHEET_PORTAL_URL=https://expressrecruitment.timesheetportal.com
